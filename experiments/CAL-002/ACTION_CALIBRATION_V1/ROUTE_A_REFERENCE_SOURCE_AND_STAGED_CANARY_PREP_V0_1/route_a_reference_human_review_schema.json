          "type": "string"
        },
        "contact_onset_visibility": {
          "enum": [
            "PASS",
            "FAIL",
            "AMBIGUOUS"
          ],
          "type": "string"
        },
        "continuous_shot_confirmation": {
          "type": "boolean"
        },
        "cuts": {
          "type": "boolean"
        },
        "ending_motion_validity": {
          "enum": [
            "PASS",
            "FAIL",
            "AMBIGUOUS"
          ],
          "type": "string"
        },
        "extended_arm_freeze": {
          "type": "boolean"
        },
        "feet_visibility": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "type": "string"
        },
        "foot_result_count": {
          "minimum": 0,
          "type": "integer"
        },
        "foot_result_presence": {
          "type": "boolean"
        },
        "foot_result_type": {
          "enum": [
            "REAR_FOOT_RECOVERY_PLACEMENT",
            "REAR_FOOT_RECOIL_STEP",
            "NONE",
            "OTHER",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "full_body_visibility": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "type": "string"
        },
        "full_mp4_review_confirmation": {
          "type": "boolean"
        },
        "human_decision": {
          "enum": [
            "PASS_FOR_FUTURE_UPLOAD_AUTHORIZATION_REQUEST",
            "NEEDS_REFERENCE_FIX",
            "REJECT_RIGHTS_OR_PROVENANCE",
            "REJECT_SAFETY_OR_PRIVACY",
            "REJECT_MOTION_SPEC"
          ],
          "type": "string"
        },
        "identifiable_person_status": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "neutral_background_confirmation": {
          "type": "boolean"
        },
        "neutral_figure_confirmation": {
          "type": "boolean"
        },
        "onset_visibility": {
          "enum": [
            "PASS",
            "FAIL",
            "AMBIGUOUS"
          ],
          "type": "string"
        },
        "overall_motion_reference_usability": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "post_contact_causality": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "private_data_status": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "prolonged_contact": {
          "type": "boolean"
        },
        "real_harm_status": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reference_camera_distinctiveness_risk": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reference_costume_distinctiveness_risk": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reference_id": {
          "enum": [
            "ACTION_REF_PUSH_01",
            "ACTION_REF_IMPACT_01"
          ],
          "type": "string"
        },
        "reference_identity_distinctiveness_risk": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reference_scene_distinctiveness_risk": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
