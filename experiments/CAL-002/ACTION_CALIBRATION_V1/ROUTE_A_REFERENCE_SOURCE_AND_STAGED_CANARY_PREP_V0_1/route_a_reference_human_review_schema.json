            "UNKNOWN"
          ],
          "type": "string"
        },
        "release_retraction": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "reviewer_notes": {
          "minLength": 1,
          "type": "string"
        },
        "rights_provenance_status": {
          "enum": [
            "PASS",
            "BLOCKED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "static_camera_confirmation": {
          "type": "boolean"
        },
        "technical_validity": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "type": "string"
        },
        "third_party_ip_status": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "torso_displacement_or_recoil": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL",
            "UNKNOWN"
          ],
          "type": "string"
