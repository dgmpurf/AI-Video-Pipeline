  },
  "$id": "CAL002_ROUTE_A_REFERENCE_HUMAN_REVIEW_SCHEMA_V0_1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for two complete-MP4 human reviews of future Route A action references. A contact sheet cannot replace full reference review.",
  "properties": {
    "record_version": {
      "const": "CAL002_ROUTE_A_REFERENCE_HUMAN_REVIEW_RECORD_V0_1"
    },
    "reviews": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/review_record"
            },
            {
              "properties": {
                "action_family": {
                  "const": "push_reaction"
                },
                "reference_id": {
                  "const": "ACTION_REF_PUSH_01"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/review_record"
            },
            {
              "properties": {
                "action_family": {
                  "const": "brief_impact_recoil"
                },
                "reference_id": {
                  "const": "ACTION_REF_IMPACT_01"
                }
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "schema_id": {
      "const": "CAL002_ROUTE_A_REFERENCE_HUMAN_REVIEW_SCHEMA_V0_1"
    }
  },
  "required": [
    "schema_id",
    "record_version",
    "reviews"
  ],
  "title": "CAL-002 Route A Reference Human Review",
  "type": "object"
}
